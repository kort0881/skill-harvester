# Обязательно для AI-анализа и консолидации.
GROQ_API_KEY=replace_with_your_groq_api_key

# Необязательно, но настоятельно рекомендуется для локальных запусков (повышает лимиты GitHub Search API).
GITHUB_TOKEN=github_pat_replace_me

# Модель для ежедневной проверки skills.
GROQ_ANALYSIS_MODEL=openai/gpt-oss-120b

# Модель для ежемесячной консолидации похожих skills.
GROQ_CONSOLIDATION_MODEL=openai/gpt-oss-120b

# Лимиты локальных запусков.
MAX_CANDIDATES_PER_RUN=40
MAX_ANALYZE_PER_RUN=12
MAX_CONSOLIDATION_GROUPS=5

# Порог публикации.
MIN_TOTAL_SCORE=72
MIN_QUALITY_SCORE=65
MIN_UNIQUENESS_SCORE=55
